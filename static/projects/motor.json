{
  "version": 1,
  "code": "#include \"stm32f103.h\"\n\n// TB6612 A channel with real GPIO direction control.\n// The motor speed and encoder count are ideal estimates.\nint main(void) {\n  for (int pin = 0; pin < 4; pin++) board_gpio_output(GPIOB, pin);\n  board_gpio_write(GPIOB, 0, 1); // STBY enabled\n  board_gpio_write(GPIOB, 3, 1); // PWMA 100% duty\n  for (;;) {\n    board_gpio_write(GPIOB, 1, 1);\n    board_gpio_write(GPIOB, 2, 0);\n    board_delay_ms(500);\n    board_gpio_write(GPIOB, 1, 0);\n    board_gpio_write(GPIOB, 2, 1);\n    board_delay_ms(500);\n  }\n}\n",
