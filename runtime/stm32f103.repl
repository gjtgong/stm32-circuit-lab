// STM32F103ZET6 first-MVP board model.
//
// The generic Renode STM32F103 description maps very large flash/RAM aliases
// and loads an SVD over the network.  This local description keeps the memory
// sizes exact (512 KiB flash, 64 KiB SRAM) and has no network dependency.
// The same flash object is visible at the STM32 reset alias and at the real
// STM32F1 flash address, so ELF sections retain their hardware addresses while
// the Cortex-M reset fetch at 0x00000000 still reaches the vector table.

flash: Memory.MappedMemory @ {
        sysbus 0x00000000;
        sysbus 0x08000000
    }
    size: 0x80000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x10000

// RCC and AFIO are retained as harmless mapped storage so normal clock-enable
// and pin-configuration writes do not fault. Their advanced clock/AF behavior
// is outside the first MVP model.
rcc: Memory.MappedMemory @ sysbus 0x40021000
    size: 0x400

afio: Memory.MappedMemory @ sysbus 0x40010000
    size: 0x400

usart1: UART.STM32_UART @ sysbus <0x40013800, +0x100>
    frequency: 72000000
    -> nvic@37

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 72000000
    IRQ -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m3"
    nvic: nvic

gpioPortA: GPIOPort.STM32F1GPIOPort @ sysbus <0x40010800, +0x400>
gpioPortB: GPIOPort.STM32F1GPIOPort @ sysbus <0x40010C00, +0x400>
gpioPortC: GPIOPort.STM32F1GPIOPort @ sysbus <0x40011000, +0x400>
gpioPortD: GPIOPort.STM32F1GPIOPort @ sysbus <0x40011400, +0x400>
gpioPortE: GPIOPort.STM32F1GPIOPort @ sysbus <0x40011800, +0x400>
gpioPortF: GPIOPort.STM32F1GPIOPort @ sysbus <0x40011C00, +0x400>
gpioPortG: GPIOPort.STM32F1GPIOPort @ sysbus <0x40012000, +0x400>
